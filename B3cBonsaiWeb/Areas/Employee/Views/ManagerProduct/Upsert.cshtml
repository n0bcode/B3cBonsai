@model SanPhamVM

<div class="offcanvas-header">
    <h5 class="modal-title" id="#gridSystemModal">@((Model == null || Model.SanPham == null || Model.SanPham.Id == 0) ? "Thêm sản phẩm" : "Cập nhật sản phẩm")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

<div class="offcanvas-body">
    <div class="container-fluid">
        <form asp-action="Upsert" method="post" id="upsertForm" enctype="multipart/form-data">
            <div class="row">
                @{
                    var hasErrors = ViewData.ModelState.Any(x => x.Value.Errors.Any());
                }
                @if (hasErrors)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                }

                <div class="row justify-content-center mb-3">
                    @* <div class="col-md-3 text-center">
                        <img class="img-thumbnail" src="~/images/product/default.jpg" alt="Hình ảnh sản phẩm" style="height:100px;width:100%;object-fit:contain" />
                    </div> *@
                    <div class="col-md-12">
                        <label class="form-label">Chọn hình ảnh</label>
                        <input type="file" name="HinhAnhs" class="form-control" multiple accept="image/*" />
                    </div>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.Id" class="form-label">Mã sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="SanPham.Id" class="form-control" readonly />
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.TenSanPham" class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="SanPham.TenSanPham" class="form-control" required />
                    <span asp-validation-for="SanPham.TenSanPham" class="text-danger"></span>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.DanhMucId" class="form-label">Danh mục</label>
                    <select asp-for="SanPham.DanhMucId" class="default-select form-control" asp-items="@Model.DanhMucSanPham" required>
                        <option value="">Chọn danh mục</option>
                    </select>
                    <span asp-validation-for="SanPham.DanhMucId" class="text-danger"></span>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.SoLuong" class="form-label">Số lượng</label>
                    <input asp-for="SanPham.SoLuong" class="form-control" required min="1"/>
                    <span asp-validation-for="SanPham.SoLuong" class="text-danger"></span>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.Gia" class="form-label">Giá</label>
                    <input asp-for="SanPham.Gia" class="form-control" required min="10000" />
                    <span asp-validation-for="SanPham.Gia" class="text-danger"></span>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.TrangThai" class="form-label">Trạng thái</label>
                    <select asp-for="SanPham.TrangThai" class="default-select form-control" required>
                        <option value="true">Đang bán</option>
                        <option value="false">Ngừng bán</option>
                    </select>
                    <span asp-validation-for="SanPham.TrangThai" class="text-danger"></span>
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.NgayTao" class="form-label">Ngày tạo</label>
                    <input asp-for="SanPham.NgayTao" type="date" class="form-control" readonly />
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.NgaySuaDoi" class="form-label">Ngày sửa đổi</label>
                    <input asp-for="SanPham.NgaySuaDoi" type="date" class="form-control" readonly />
                </div>

                <div class="col-xl-12 mb-3 custom-ekeditor">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label asp-for="SanPham.MoTa" class="form-label mb-0">Mô tả</label>
                        <button type="button" class="btn btn-info btn-xs" onclick="generateAIDescription()">
                            <i class="fa fa-magic"></i> AI Gợi ý mô tả
                        </button>
                    </div>
                    <textarea asp-for="SanPham.MoTa" rows="4" class="form-control tinymce" required id="ckeditor"></textarea>
                    <span asp-validation-for="SanPham.MoTa" class="text-danger"></span>
                </div>

                <!-- 3D & AR Management -->
                <div class="col-xl-6 mb-3">
                    <label class="form-label">Tải lên Model 3D (.glb)</label>
                    <div class="input-group">
                        <input type="file" name="Model3DFile" class="form-control" accept=".glb" />
                        <button type="button" class="btn btn-info btn-sm" onclick="requestAI3DGeneration()">
                            <i class="fa fa-cube"></i> AI Tạo 3D
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SanPham.Model3DPath))
                    {
                        <div class="mt-2 text-success">
                            <i class="fa fa-check"></i> Đã có Model 3D: @Model.SanPham.Model3DPath
                        </div>
                    }
                </div>

                <div class="col-xl-6 mb-3">
                    <label asp-for="SanPham.IsARReady" class="form-label">Sẵn sàng AR</label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="SanPham.IsARReady" class="form-check-input" type="checkbox" role="switch">
                        <label class="form-check-label" for="SanPham_IsARReady">Cho phép xem trong AR</label>
                    </div>
                </div>

                <div class="col-xl-12 mb-3">
                    <label class="form-label">Điểm chú thích 3D (Hotspots)</label>
                    <div class="row">
                        <!-- 3D Preview Column -->
                        <div class="col-md-6 mb-3">
                            <div class="border rounded bg-dark position-relative" style="height: 400px; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(Model.SanPham.Model3DPath))
                                {
                                    <model-viewer id="hotspot-previewer"
                                                  src="@Model.SanPham.Model3DPath"
                                                  camera-controls
                                                  touch-action="none"
                                                  style="width: 100%; height: 100%; background-color: #eee;">
                                        <div slot="hotspot-template" class="hotspot-template d-none">
                                            <div class="hotspot-dot"></div>
                                        </div>
                                    </model-viewer>
                                    <div class="position-absolute bottom-0 start-0 p-2 bg-dark text-white opacity-75 small w-100">
                                        <i class="fa fa-mouse-pointer"></i> Click vào Model để thêm chú thích
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                        Vui lòng tải lên model (.glb) để xem bản xem trước
                                    </div>
                                }
                            </div>
                        </div>
                        <!-- List Editor Column -->
                        <div class="col-md-6">
                            <div id="hotspot-editor" class="border p-3 rounded bg-light h-100" style="max-height: 400px; overflow-y: auto;">
                                <div id="hotspot-list" class="mb-2">
                                    <!-- Hotspots will be added here -->
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="addHotspotRow()">
                                        <i class="fa fa-plus"></i> Thêm điểm
                                    </button>
                                    <button type="button" class="btn btn-info btn-sm" onclick="suggestAIHotspots()">
                                        <i class="fa fa-magic"></i> AI Gợi ý điểm & nội dung
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" asp-for="SanPham.Model3DMetadata" id="Model3DMetadataInput" />
                    <small class="text-muted">Admin: Click vào mô hình 3D bên trái để lấy vị trí chính xác.</small>
                    <span asp-validation-for="SanPham.Model3DMetadata" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-danger light" data-bs-dismiss="offcanvas">Hủy</button>
                <button type="submit" class="btn btn-primary">@((Model == null || Model.SanPham == null || Model.SanPham.Id == 0) ? "Thêm" : "Cập nhật")</button>
            </div>
        </form>
    </div>
</div>


<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
<script>
    // Hotspot Editor Logic
    let hotspots = [];

    function initHotspotEditor() {
        const metadataRaw = $('#Model3DMetadataInput').val();
        if (metadataRaw) {
            try {
                const data = JSON.parse(metadataRaw);
                hotspots = data.hotspots || [];
            } catch (e) { hotspots = []; }
        }
        renderHotspots();
        setupModelClick();
    }

    function setupModelClick() {
        const viewer = document.querySelector('#hotspot-previewer');
        if (!viewer) return;

        viewer.addEventListener('click', (event) => {
            const rect = viewer.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const hit = viewer.positionAndNormalFromPoint(x, y);
            if (hit) {
                const pos = `${hit.position.x}m ${hit.position.y}m ${hit.position.z}m`;
                const norm = `${hit.normal.x}m ${hit.normal.y}m ${hit.normal.z}m`; // Optional if needed
                
                hotspots.push({ 
                    position: pos, 
                    text: "New Point " + (hotspots.length + 1)
                });
                renderHotspots();
                toastr.info("Đã thêm điểm chú thích tại vị trí vừa click");
            }
        });
    }

    function renderHotspots() {
        const container = $('#hotspot-list');
        container.empty();
        
        // Clear old hotspots from viewer
        const viewer = document.querySelector('#hotspot-previewer');
        if (viewer) {
            $(viewer).find('button.hotspot-preview-dot').remove();
        }

        hotspots.forEach((hs, index) => {
            const row = $(`
                <div class="row g-2 mb-2 align-items-center hotspot-row">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm hs-pos" placeholder="Vị trí" value="${hs.position}">
                    </div>
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm hs-text" placeholder="Nội dung" value="${hs.text}">
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeHotspot(${index})">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                </div>
            `);
            container.append(row);

            // Add preview dot to model
            if (viewer) {
                const dot = document.createElement('button');
                dot.classList.add('hotspot-preview-dot');
                dot.slot = `hotspot-item-${index}`;
                dot.dataset.position = hs.position;
                dot.style.cssText = "width: 15px; height: 15px; border-radius: 50%; background: #f00; border: 2px solid #fff; cursor: pointer;";
                viewer.appendChild(dot);
            }
        });
        updateMetadata();
    }

    function addHotspotRow() {
        hotspots.push({ position: "0m 0m 0m", text: "New Hotspot" });
        renderHotspots();
    }

    function removeHotspot(index) {
        hotspots.splice(index, 1);
        renderHotspots();
    }

    function updateMetadata() {
        const currentData = [];
        $('.hotspot-row').each(function() {
            currentData.push({
                position: $(this).find('.hs-pos').val(),
                text: $(this).find('.hs-text').val()
            });
        });
        $('#Model3DMetadataInput').val(JSON.stringify({ hotspots: currentData }));
    }

    $(document).on('change', '.hs-pos, .hs-text', updateMetadata);
    
    initHotspotEditor();

    function requestAI3DGeneration() {
        toastr.info("Tính năng đang được phát triển: Kết nối với Meshy.ai / Luma AI để tạo mô hình từ ảnh.");
        // Workflow: Check if images exist -> Send to API -> Long polling for result -> Save GLB
    }

    function generateAIDescription() {
        const name = $('#SanPham_TenSanPham').val();
        const category = $('#SanPham_DanhMucId option:selected').text();
        
        if (!name || !category || category === "Chọn danh mục") {
            toastr.warning("Vui lòng nhập tên và chọn danh mục trước khi dùng AI.");
            return;
        }

        toastr.info("Đang khởi tạo mô tả bằng AI...");
        $.post('/Employee/ManagerProduct/GenerateDescription', { name, category, features: "" }, function(res) {
            if (res.success) {
                tinymce.get('ckeditor').setContent(res.description);
                toastr.success("Đã tạo mô tả thành công!");
            }
        });
    }

    function suggestAIHotspots() {
        const name = $('#SanPham_TenSanPham').val();
        const description = tinymce.get('ckeditor').getContent({format: 'text'});

        if (!name || !description) {
            toastr.warning("Vui lòng nhập tên và mô tả trước khi dùng AI gợi ý Hotspots.");
            return;
        }

        toastr.info("AI đang phân tích và gợi ý các điểm chú thích...");
        $.post('/Employee/ManagerProduct/SuggestHotspots', { name, description }, function(res) {
            if (res.success) {
                try {
                    const suggested = JSON.parse(res.hotspots);
                    // Add AI suggested hotspots as unpositioned points if model not clicked yet
                    // or just fill the text for existing ones? Let's add new ones.
                    suggested.forEach(item => {
                        hotspots.push({ 
                            position: "0m 1m 0m", 
                            text: `[AI] ${item.title}: ${item.description}` 
                        });
                    });
                    renderHotspots();
                    toastr.success("Đã nhận gợi ý điểm chú thích từ AI!");
                } catch(e) { console.error(e); }
            }
        });
    }

    // Xử lý khi form được submit
    $("#upsertForm").on("submit", function(e) {
        updateMetadata(); // Ensure metadata is fresh
        e.preventDefault(); 

        // Lấy dữ liệu từ form
        var formData = new FormData(this);

        $.ajax({
            url: '/Employee/ManagerProduct/Upsert', // URL của action
            method: 'POST', // Phương thức POST
            data: formData, // Dữ liệu form
            processData: false, // Không xử lý dữ liệu
            contentType: false, // Không cần thiết lập contentType
            success: function(response) {
                if (response.success) {
                    // Nếu thêm thành công, hiển thị thông báo thành công
                    toastr.success("Thêm sản phẩm thành công", "Thêm", { timeOut: 5000 });
                    dataTable.ajax.reload();
                } else {
                    $('#upsertObject').html(response.data);

                    // Thông báo lỗi với toastr
                    toastr.error("Lỗi thêm sản phẩm, vui lòng kiểm tra dữ liệu nhập vào!", "Lỗi", { timeOut: 5000 });
                }
            },
            error: function(xhr, status, error) {
                // Hiển thị thông báo lỗi chung nếu có lỗi trong quá trình gọi Ajax
                toastr.error("Có lỗi xảy ra trong quá trình xử lý. Vui lòng thử lại!", "Lỗi", { timeOut: 5000 });
                console.log(xhr);
            }
        });
    });
</script>