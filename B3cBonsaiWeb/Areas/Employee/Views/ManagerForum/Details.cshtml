@model B3cBonsai.Models.ChuDe

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0 text-white">@Model.TieuDe</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.LinkAnh))
        {
            <div class="row">
                <!-- Left Column: Images -->
                <div class="col-md-5">
                    <div id="carouselImages" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner rounded shadow-sm">
                            @{
                                var images = Model.LinkAnh.Split(';', StringSplitOptions.RemoveEmptyEntries);
                                for (int i = 0; i < images.Length; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="~/@images[i]" class="d-block w-100" style="height: 400px; object-fit: cover;"
                                            alt="Ảnh @i">
                                    </div>
                                }
                            }
                        </div>
                        @if (images.Length > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages"
                                data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselImages"
                                data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Right Column: Info & Content -->
                <div class="col-md-7">
                    <div class="d-flex justify-content-between mb-3">
                        <div>
                            <strong>Người tạo:</strong> @(Model.NguoiDungUngDung?.HoTen ?? "N/A") <br />
                            <small class="text-muted">@Model.NguoiDungUngDung?.Email</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-secondary">@Model.DanhMucDienDan.TenDanhMuc</span><br />
                            <small class="text-muted">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                    <hr />
                    <div class="post-content p-3 bg-light rounded" style="max-height: 300px; overflow-y: auto;">
                        @Html.Raw(Model.NoiDung.Replace("\n", "<br/>"))
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- No Images: Full Width Layout -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Người tạo:</strong> @(Model.NguoiDungUngDung?.HoTen ?? "N/A") <br />
                    <strong>Email:</strong> @(Model.NguoiDungUngDung?.Email ?? "N/A")
                </div>
                <div class="col-md-6 text-end">
                    <strong>Ngày tạo:</strong> @Model.NgayTao.ToString("dd/MM/yyyy HH:mm") <br />
                    <strong>Danh mục:</strong> @Model.DanhMucDienDan.TenDanhMuc
                </div>
            </div>
            <hr />
            <div class="post-content p-3 bg-light rounded">
                @Html.Raw(Model.NoiDung.Replace("\n", "<br/>"))
            </div>
        }
    </div>
    <div class="card-footer">
        <h6>Bình luận (@(Model.BaiViets?.Count() ?? 0))</h6>
        <div style="max-height: 400px; overflow-y: auto;">
            @if (Model.BaiViets != null)
            {
                foreach (var post in Model.BaiViets.OrderBy(p => p.NgayTao))
                {
                    <div class="border-bottom p-2">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">@(post.NguoiDungUngDung?.HoTen ?? "N/A")</span>
                            <small class="text-muted">@post.NgayTao.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <p class="mb-1">@post.NoiDung</p>
                    </div>
                }
            }
        </div>
    </div>
</div>