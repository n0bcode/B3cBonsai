@model B3cBonsai.Models.CayCuaToi

@{
    var title = Model.Id != 0 ? "Chỉnh Sửa Thông Tin Cây" : "Thêm Cây Mới Vào Vườn";
    ViewData["Title"] = title;
}

<section class="breadcrumb-area">
    <div class="container">
        <ul class="breadcrumb-ul">
            <li class="breadcrumb-li"><a asp-action="Index">Vườn Cây Của Tôi</a></li>
            <li class="breadcrumb-li"><span class="breadcrumb-text">@title</span></li>
        </ul>
    </div>
</section>

<section class="section-ptb">
    <div class="container">
        <h2 class="mb-4">@title</h2>
        <form method="post" enctype="multipart/form-data">
            <div class="row">
                <input asp-for="Id" hidden />
                <input asp-for="HinhAnhDaiDien" hidden />
                <input asp-for="NguoiDungId" hidden />

                <div class="col-8">
                    <div class="form-group mb-3">
                        <label asp-for="TenCay" class="control-label fw-bold"></label>
                        <input asp-for="TenCay" class="form-control" placeholder="Đặt biệt danh cho cây của bạn..." />
                        <span asp-validation-for="TenCay" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SanPhamId" class="control-label fw-bold">Liên kết với sản phẩm (Tùy chọn)</label>
                        <select asp-for="SanPhamId" asp-items="@ViewBag.SanPhams" class="form-control">
                            <option value="">-- Chọn Sản Phẩm (Nếu có) --</option>
                        </select>
                        <span asp-validation-for="SanPhamId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NgayMua" class="control-label fw-bold"></label>
                            <input asp-for="NgayMua" class="form-control" type="date" />
                            <span asp-validation-for="NgayMua" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TrangThai" class="control-label fw-bold"></label>
                            <select asp-for="TrangThai" class="form-control">
                                <option value="Bình thường">Bình thường</option>
                                <option value="Đang phát triển">Đang phát triển</option>
                                <option value="Ra hoa">Ra hoa</option>
                                <option value="Cần chăm sóc đặc biệt">Cần chăm sóc đặc biệt</option>
                                <option value="Đã chết">Đã chết</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="GhiChu" class="control-label fw-bold"></label>
                        <textarea asp-for="GhiChu" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                         <label class="control-label fw-bold">Hình Ảnh Đại Diện</label>
                         <input type="file" name="file" class="form-control" />
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary w-100">@(Model.Id!=0 ? "Cập Nhật" : "Thêm Ngay")</button>
                        <a asp-action="Index" class="btn btn-secondary w-100 mt-2">Quay Lại</a>
                    </div>
                </div>
                <div class="col-4">
                    @if (!string.IsNullOrEmpty(Model.HinhAnhDaiDien))
                    {
                        <img src="@Model.HinhAnhDaiDien" width="100%" class="rounded border" />
                    }
                    else
                    {
                         <img src="https://placehold.co/400x400?text=Preview" width="100%" class="rounded border" />
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
