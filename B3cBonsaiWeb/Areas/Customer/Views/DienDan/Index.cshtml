@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<B3cBonsai.Models.ChuDe>

@{
    ViewData["Title"] = "Diễn Đàn Bonsai";
}

<!-- breadcrumb start -->
<section class="breadcrumb-area">
    <div class="container">
        <div class="col">
            <div class="row">
                <div class="breadcrumb-index">
                    <ul class="breadcrumb-ul">
                        <li class="breadcrumb-li">
                            <a class="breadcrumb-link" asp-area="Customer" asp-controller="Home"
                                asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="breadcrumb-li">
                            <span class="breadcrumb-text">Diễn Đàn</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <!-- Header Section -->
                <div class="section-capture mb-5">
                    <div class="section-title">
                        <h2>Cộng Đồng Bonsai Việt</h2>
                        <p class="text-muted">Nơi chia sẻ đam mê, hỏi đáp kỹ thuật và kết nối những người yêu cây.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-action="TaoChuDe" class="btn btn-style"><i class="fa fa-pencil"></i> Đăng Bài Mới</a>
                    </div>
                </div>

                <!-- Thread List -->
                @if (Model != null && Model.Count > 0)
                {
                    <div class="thread-list">
                        @foreach (var item in Model)
                        {
                            <div class="single-product-wrap mb-4 p-4 border rounded" style="display: block; width: 100%;">
                                <div class="product-caption" style="text-align: left;">
                                    <div class="product-content">
                                        <div class="product-title">
                                            <h6>
                                                <a asp-action="ChiTiet" asp-route-id="@item.Id" asp-route-slug="@item.Slug"
                                                    style="font-size: 1.25rem;">
                                                    @item.TieuDe
                                                </a>
                                            </h6>
                                        </div>
                                        <div class="product-description mt-2">
                                            <p class="mb-2"
                                                style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                @Html.Raw(item.NoiDung)
                                            </p>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-3 text-muted small">
                                            <div>
                                                <i class="fa fa-user me-1"></i> @(item.NguoiDungUngDung?.HoTen ?? "Ẩn danh")
                                                <span class="mx-2">|</span>
                                                <i class="fa fa-folder-open me-1"></i> @(item.DanhMucDienDan?.TenDanhMuc ??
                                                                                        "Chung")
                                                <span class="mx-2">|</span>
                                                <i class="fa fa-clock-o me-1"></i> @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                            <div>
                                                <span class="me-3"><i class="fa fa-eye me-1"></i> @item.LuotXem</span>
                                                <span class="badge bg-light text-dark border"><i class="fa fa-comment me-1"></i>
                                                    @item.BaiViets?.Count() Trả lời</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    <div class="paginatoin-area mt-4">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                        {
                            UlElementClasses = new[] { "pagination-page-box" },
                                        LiElementClasses = new[] { "number" },
                                        PageClasses = new[] { "theme-glink" },
                                        ActiveLiElementClass = "active",
                                        LinkToPreviousPageFormat = "<i class='fa-solid fa-angle-left'></i>",
                                        LinkToNextPageFormat = "<i class='fa-solid fa-angle-right'></i>",
                                        PreviousElementClass = "page-prev",
                                        NextElementClass = "page-next",
                                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                                        ClassToApplyToFirstListItemInPager = "first",
                                        ClassToApplyToLastListItemInPager = "last",
                                        })
                </div>
                                }
                else
                {
                    <div class="alert alert-warning text-center">
                        <i class="fa fa-info-circle"></i> Hiện chưa có bài viết nào. Hãy là người đầu tiên chia sẻ!
                    </div>
                }
            </div>

            <div class="col-lg-3">
                <div class="shop-sidebar-wrap">
                    <!-- Statistics Sidebar -->
                    <div class="shop-sidebar mb-5 pb-4 border-bottom">
                        <h6 class="shop-title">Thống Kê</h6>
                        <ul class="brand-ul mt-3">
                            <li class="cat-checkbox">
                                <span class="check-name"><i class="fa fa-comments me-2"></i> Tổng chủ đề:</span>
                                <span class="count-check">(@(Model?.TotalItemCount ?? 0))</span>
                            </li>
                            <li class="cat-checkbox mt-2">
                                <span class="check-name"><i class="fa fa-users me-2"></i> Thành viên:</span>
                                <span class="count-check">...</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Hot Topics Sidebar -->
                    <div class="shop-sidebar">
                        <h6 class="shop-title">Chủ Đề Hot</h6>
                        <div class="filter-element mt-3">
                            <ul class="brand-ul">
                                @foreach (var hot in (ViewBag.HotThreads as IEnumerable<B3cBonsai.Models.ChuDe> ??
                                                                Enumerable.Empty<B3cBonsai.Models.ChuDe>()))
                                {
                                    <li class="mb-3 pb-2 border-bottom">
                                        <a asp-action="ChiTiet" asp-route-id="@hot.Id" asp-route-slug="@hot.Slug"
                                            class="text-decoration-none">
                                            <span class="check-name fw-bold" style="font-size: 0.95rem;">@hot.TieuDe</span>
                                        </a>
                                        <div class="mt-1 text-muted small">
                                            <i class="fa fa-fire text-danger"></i> @hot.LuotXem view
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>