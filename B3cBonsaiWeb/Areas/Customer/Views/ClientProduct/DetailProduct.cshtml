        <div class="modal fade" id="qrARModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Xem AR trên điện thoại</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p>Quét mã QR để xem cây <strong>@Model.TenSanPham</strong> trong không gian của bạn.</p>
                        <div id="qrcode-canvas" class="my-4 d-flex justify-content-center"></div>
                        <div class="alert alert-success py-2 small">
                            <i class="fa fa-info-circle"></i> Sử dụng Camera (iOS) hoặc Google Lens (Android).
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("PopularProducts")

        <script>
            const viewer = document.getElementById('bonsai-viewer');

            function switchMedia(type) {
                const photoCont = document.getElementById('product-photo-container');
                const viewerCont = document.getElementById('product-3d-container');
                const btnPhoto = document.getElementById('btn-show-photo');
                const btn3d = document.getElementById('btn-show-3d');

                if (type === '3d') {
                    photoCont.style.display = 'none';
                    viewerCont.style.display = 'block';
                    btn3d.classList.add('active');
                    btnPhoto.classList.remove('active');
                } else {
                    photoCont.style.display = 'block';
                    viewerCont.style.display = 'none';
                    btnPhoto.classList.add('active');
                    btn3d.classList.remove('active');
                    // Refresh slick to prevent layout issues
                    $('.slider-big').slick('setPosition');
                }
            }

            function toggleRotation() {
                if (!viewer) return;
                viewer.autoRotate = !viewer.autoRotate;
                event.currentTarget.classList.toggle('active', viewer.autoRotate);
            }

            async function takeSnapshot() {
                if (!viewer) return;
                const url = viewer.toDataURL();
                const link = document.createElement('a');
                link.download = 'B3cBonsai-Snapshot-@Model.TenSanPham.Replace(" ", "-")' + '.png';
                link.href = url;
                link.click();
            }

            let currentEnv = 'default';
            function toggleEnvironment() {
                if (!viewer) return;
                if (currentEnv === 'default') {
                    viewer.environmentImage = 'neutral';
                    currentEnv = 'neutral';
                } else {
                    viewer.environmentImage = '';
                    currentEnv = 'default';
                }
            }

            function toggleAnnotations() {
                const hotspots = document.querySelectorAll('.hotspot');
                hotspots.forEach(h => h.style.display = h.style.display === 'none' ? 'block' : 'none');
            }

            // Load Hotspots from Metadata
            document.addEventListener('DOMContentLoaded', () => {
                const metadataRaw = '@Html.Raw(Model.Model3DMetadata)';
                if (metadataRaw && viewer) {
                    try {
                        const metadata = JSON.parse(metadataRaw);
                        if (metadata.hotspots) {
                            metadata.hotspots.forEach((hs, index) => {
                                const button = document.createElement('button');
                                button.className = 'hotspot';
                                button.slot = `hotspot-${index}`;
                                button.dataset.position = hs.position;
                                button.dataset.normal = hs.normal;

                                const annotation = document.createElement('div');
                                annotation.className = 'hotspot-annotation';
                                annotation.textContent = hs.text;

                                button.appendChild(annotation);
                                viewer.appendChild(button);
                            });
                        }
                    } catch (e) { console.error('Error parsing 3D metadata', e); }
                }
            });

            function showARQRCode() {
                const modal = new bootstrap.Modal(document.getElementById('qrARModal'));
                document.getElementById('qrcode-canvas').innerHTML = "";
                new QRCode(document.getElementById('qrcode-canvas'), {
                    text: "@currentUrl",
                    width: 256,
                    height: 256,
                    colorDark: "#2c5e1a",
                    colorLight: "#ffffff"
                });
                modal.show();
            }
        </script>

        <!-- AR QR Modal -->
        <div class="modal fade" id="qrARModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Xem AR trên điện thoại</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p>Quét mã QR dưới đây để xem cây <strong>@Model.TenSanPham</strong> trực tiếp trong không gian của bạn
                            qua thực tế tăng cường (AR).</p>
                            <div id="qrcode-canvas" class="my-4"></div>
                            <div class="alert alert-info py-2 small">
                                <i class="fa fa-info-circle"></i> Sử dụng camera điện thoại (iOS) hoặc Google Lens (Android).
                            </div>
                        </div>
                    </div>
                </div>
            </div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/js//customer/comment.js" asp-append-version="true"></script>
    <script>loadContainerComments('@Model.Id')</script>

