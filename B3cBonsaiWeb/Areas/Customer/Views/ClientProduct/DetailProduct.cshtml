        position: relative;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        overflow: visible !important;
        }

        .media-toggle-wrapper {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        display: flex;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        padding: 5px;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .media-toggle-btn {
        border: none;
        background: none;
        padding: 8px 20px;
        border-radius: 40px;
        font-size: 14px;
        font-weight: 600;
        color: #666;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .media-toggle-btn.active {
        background: #2c5e1a;
        color: #fff;
        box-shadow: 0 4px 10px rgba(44, 94, 26, 0.3);
        }

        .media-toggle-btn i {
        font-size: 16px;
        }

        .product-3d-view {
        border-radius: 12px;
        overflow: hidden;
        background: radial-gradient(circle, #f8fcf7 0%, #e9f0e4 100%);
        }

        /* Hotspot Styling */
        .hotspot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: none;
        background-color: #2c5e1a;
        box-shadow: 0 0 10px rgba(44, 94, 26, 0.5);
        cursor: pointer;
        position: relative;
        }

        .hotspot::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: inherit;
        transform: translate(-50%, -50%);
        animation: pulse 2s infinite;
        }

        @@keyframes pulse {
        0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.8;
        }

        100% {
        transform: translate(-50%, -50%) scale(2.5);
        opacity: 0;
        }
        }

        /* Info Section Typography */
        .premium-title {
            font-family: 'Merriweather', serif;
            font-weight: 700;
            font-size: 2.8rem;
            color: #1a1a1a;
            line-height: 1.2;
        }

        .premium-price {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 2.2rem;
            color: #2c5e1a;
        }

        .description-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #555;
        }

        .attribute-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            background: #fdfdfd;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #f0f0f0;
        }

        .attr-label {
            font-weight: 600;
            color: #888;
            font-size: 0.9rem;
            text-transform: uppercase;
            display: block;
            margin-bottom: 4px;
        }

        .attr-value {
            font-weight: 600;
            color: #333;
            font-size: 1.1rem;
        }

        .stock-badge {
            color: #2c5e1a;
            background: #e9f0e4;
            padding: 2px 8px;
            border-radius: 4px;
        }

        /* Action Buttons */
        .action-buttons-wrap {
            display: flex;
            gap: 15px;
        }

        .premium-btn {
            flex: 1;
            height: 60px;
            border-radius: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: none;
        }

        .btn-cart {
            background: #1a1a1a;
            color: #fff;
        }

        .btn-cart:hover {
            background: #333;
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

        .btn-buy {
            background: #2c5e1a;
            color: #fff;
        }

        .btn-buy:hover {
            background: #3a7a22;
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(44, 94, 26, 0.25);
        }

        /* AR QR Social */
        .social-ar-wrap {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .qr-ar-btn {
            background: #f8fbf7;
            border: 2px dashed #2c5e1a;
            color: #2c5e1a;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

        .qr-ar-btn:hover {
            background: #2c5e1a;
            color: #fff;
        }

        .product-3d-view {
            position: relative;
            overflow: hidden;
        }

        .controls-3d {
            position: absolute;
